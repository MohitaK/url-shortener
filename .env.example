# Neon Postgres connection string. Get this from the Neon dashboard
# under Connection Details. Requires sslmode=require.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random integer XORed with the row id to obfuscate short codes (see
# ARCHITECTURE.md). Generate once with:
#   node -e "console.log(require('crypto').randomInt(1, 2**31))"
# Must stay constant after codes are issued, or existing codes break.
SHORT_CODE_SECRET=1804289383

# Base URL used to build the full short link returned to clients
# (e.g. `${BASE_URL}/${shortCode}`). Locally this is your dev server;
# in Render, set this to the deployed service's actual URL.
BASE_URL=http://localhost:3000
